---
import { getCollection } from 'astro:content';
import { SITE, cities } from '../data/site';
import Logo from './Logo.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const year = 2026;
---
<footer class="bg-ink text-white">
  <div class="mx-auto max-w-7xl px-4 py-14">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <Logo dark={false} />
        <p class="mt-4 max-w-xs text-sm text-white/60">{SITE.description}</p>
        <div class="mt-5 flex gap-3">
          <a href="#" aria-label="Facebook" class="grid h-10 w-10 place-items-center rounded-full bg-white/10 transition hover:bg-brand-600"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H7v3h3v7h3v-7h3l1-3h-4v-2c0-.6.4-1 1-1Z"></path></svg></a>
          <a href="#" aria-label="Instagram" class="grid h-10 w-10 place-items-center rounded-full bg-white/10 transition hover:bg-brand-600"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg></a>
          <a href="#" aria-label="Google" class="grid h-10 w-10 place-items-center rounded-full bg-white/10 transition hover:bg-brand-600"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 11v3.5h4.9c-.2 1.2-1.5 3.6-4.9 3.6A5.1 5.1 0 1 1 12 7c1.5 0 2.5.6 3 1.1l2.1-2C15.8 4.8 14.1 4 12 4a8 8 0 1 0 0 16c4.6 0 7.7-3.2 7.7-7.8 0-.5 0-.9-.1-1.2H12Z"></path></svg></a>
        </div>
      </div>
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white/40">Services</h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          {services.map((s) => (
            <li><a href={`/services/${s.id}`} class="text-white/70 transition hover:text-brand-400">{s.data.name}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white/40">Service Areas</h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          {cities.map((city) => (
            <li><a href="/contact" class="text-white/70 transition hover:text-brand-400">{city}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white/40">Get in Touch</h3>
        <ul class="mt-4 space-y-2.5 text-sm text-white/70">
          <li class="flex items-center gap-2 text-brand-400"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"></path></svg><span class="text-white/70">{SITE.phone}</span></li>
          <li class="flex items-center gap-2"><svg class="h-4 w-4 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg> {SITE.email}</li>
          <li class="flex items-center gap-2"><svg class="h-4 w-4 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg> Serving Your Area</li>
        </ul>
        <a href="/contact" class="mt-5 inline-block rounded-full bg-brand-600 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-brand-500">Free Quote</a>
      </div>
    </div>
    <div class="mt-12 flex flex-col items-center justify-between gap-3 border-t border-white/10 pt-6 text-sm text-white/50 sm:flex-row">
      <p>© {year} {SITE.name}. All rights reserved.</p>
      <div class="flex gap-5"><a href="/privacy" class="transition hover:text-white">Privacy Policy</a><a href="/terms" class="transition hover:text-white">Terms of Service</a></div>
    </div>
  </div>
</footer>

<a href={SITE.phoneHref} class="fixed bottom-5 right-5 z-40 grid h-14 w-14 place-items-center rounded-full bg-gradient-to-br from-brand-500 to-brand-700 text-white shadow-lift transition hover:scale-105 sm:hidden" aria-label="Call now">
  <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"></path></svg>
</a>
