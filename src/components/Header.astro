---
import { getCollection } from 'astro:content';
import { NAV, SITE } from '../data/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<div x-data="{ mobileOpen: false }">
  <header
    x-data="{ atTop: true }"
    @scroll.window="atTop = window.pageYOffset < 12"
    :class="atTop ? 'bg-white/70' : 'bg-white/90 shadow-soft'"
    class="sticky top-0 z-40 backdrop-blur-xl transition-all duration-300"
  >
    <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 lg:py-4" aria-label="Primary">
      <Logo dark={true} />

      <div class="hidden items-center gap-1 lg:flex">
        {
          NAV.map((n) =>
            n.key === 'services' ? (
              <div x-data="{ open: false }" @mouseenter="open=true" @mouseleave="open=false" @keydown.escape="open=false" class="relative">
                <a
                  href="/services"
                  @click="open=!open"
                  :aria-expanded="open"
                  class:list={['nav-link flex items-center gap-1 rounded-lg px-3.5 py-2 text-sm font-semibold text-ink/80 transition hover:bg-brand-50 hover:text-brand-700', { 'is-active': isActive('/services') }]}
                >
                  Services
                  <svg class="h-4 w-4 transition" :class="open && 'rotate-180'" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="m6 9 6 6 6-6"></path></svg>
                </a>
                <div x-show="open" x-transition.origin.top class="absolute left-1/2 top-full z-50 w-[36rem] -translate-x-1/2 pt-3" x-cloak>
                  <div class="rounded-2xl border border-slate-100 bg-white p-2.5 shadow-soft">
                    <div class="grid grid-cols-2 gap-1">
                      {
                        services.map((s) => (
                          <a href={`/services/${s.id}`} class="group flex items-start gap-3 rounded-xl p-3 transition hover:bg-brand-50">
                            <span class="grid h-10 w-10 shrink-0 place-items-center overflow-hidden rounded-lg bg-brand-50 text-brand-700 transition group-hover:bg-white">
                              <Icon paths={s.data.icon} />
                            </span>
                            <span>
                              <span class="block text-sm font-bold">{s.data.name}</span>
                              <span class="block text-xs text-slate-500">{s.data.short}</span>
                            </span>
                          </a>
                        ))
                      }
                    </div>
                    <a href="/services" class="mt-1 flex items-center justify-center gap-1.5 rounded-xl bg-brand-50 px-3 py-2.5 text-sm font-bold text-brand-700 transition hover:bg-brand-600 hover:text-white">
                      View all services
                      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                    </a>
                  </div>
                </div>
              </div>
            ) : (
              <a
                href={n.href}
                class:list={['nav-link rounded-lg px-3.5 py-2 text-sm font-semibold text-ink/80 transition hover:bg-brand-50 hover:text-brand-700', { 'is-active': isActive(n.href) }]}
              >
                {n.label}
              </a>
            )
          )
        }
      </div>

      <div class="flex items-center gap-2.5">
        <a href={SITE.phoneHref} class="hidden items-center gap-2 rounded-full border border-slate-200 px-3.5 py-2 text-sm font-bold text-ink transition hover:border-brand-300 hover:text-brand-700 sm:flex">
          <span class="grid h-7 w-7 place-items-center rounded-full bg-brand-50 text-brand-700">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"></path></svg>
          </span>{SITE.phone}
        </a>
        <a href="/contact" class="hidden rounded-full bg-gradient-to-r from-brand-600 to-brand-700 px-5 py-2.5 text-sm font-bold text-white shadow-lift transition hover:brightness-110 sm:inline-block">Get a Free Quote</a>
        <button @click="mobileOpen=true" class="grid h-11 w-11 place-items-center rounded-xl border border-slate-200 lg:hidden" aria-label="Open menu">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </button>
      </div>
    </nav>
  </header>

  <!-- Mobile drawer -->
  <div x-show="mobileOpen" class="fixed inset-0 z-50 lg:hidden" x-cloak>
    <div x-show="mobileOpen" x-transition.opacity @click="mobileOpen=false" class="absolute inset-0 bg-ink/40 backdrop-blur-xs"></div>
    <aside
      x-show="mobileOpen"
      x-transition:enter="transition ease-out duration-300" x-transition:enter-start="translate-x-full" x-transition:enter-end="translate-x-0"
      x-transition:leave="transition ease-in duration-200" x-transition:leave-start="translate-x-0" x-transition:leave-end="translate-x-full"
      class="absolute right-0 top-0 flex h-full w-[84%] max-w-sm flex-col bg-white shadow-2xl"
    >
      <div class="flex items-center justify-between border-b border-slate-100 p-4">
        <span class="font-display text-lg font-extrabold">Menu</span>
        <button @click="mobileOpen=false" class="grid h-10 w-10 place-items-center rounded-lg bg-slate-100" aria-label="Close menu">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"></path></svg>
        </button>
      </div>
      <nav class="flex flex-col gap-1 overflow-y-auto p-4 text-base font-semibold">
        {
          NAV.map((n) =>
            n.key === 'services' ? (
              <div x-data="{ o: false }">
                <button @click="o=!o" :aria-expanded="o" class="nav-link flex w-full items-center justify-between rounded-xl px-4 py-3 transition hover:bg-brand-50 hover:text-brand-700">
                  <span>Services</span>
                  <svg class="h-4 w-4 transition" :class="o && 'rotate-180'" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="m6 9 6 6 6-6"></path></svg>
                </button>
                <div x-show="o" x-collapse class="ml-2 border-l border-slate-100 pl-3">
                  <a @click="mobileOpen=false" href="/services" class="block rounded-lg px-4 py-2.5 text-sm font-semibold text-brand-700">All Services</a>
                  {
                    services.map((s) => (
                      <a @click="mobileOpen=false" href={`/services/${s.id}`} class="block rounded-lg px-4 py-2.5 text-sm text-slate-600 transition hover:text-brand-700">
                        {s.data.name}
                      </a>
                    ))
                  }
                </div>
              </div>
            ) : (
              <a @click="mobileOpen=false" href={n.href} class:list={['nav-link rounded-xl px-4 py-3 transition hover:bg-brand-50 hover:text-brand-700', { 'is-active': isActive(n.href) }]}>
                {n.label}
              </a>
            )
          )
        }
      </nav>
      <div class="mt-auto space-y-3 border-t border-slate-100 p-4">
        <a href={SITE.phoneHref} class="flex items-center justify-center gap-2 rounded-xl border border-slate-200 py-3 font-bold">📞 {SITE.phone}</a>
        <a @click="mobileOpen=false" href="/contact" class="block rounded-xl bg-gradient-to-r from-brand-600 to-brand-700 py-3 text-center font-bold text-white shadow-lift">Get a Free Quote</a>
      </div>
    </aside>
  </div>
</div>
