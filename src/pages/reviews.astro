---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cta from '../components/Cta.astro';
import { reviews } from '../data/site';

const star = 'm12 2 3 6.3 6.9.6-5.2 4.6 1.6 6.8L12 17l-6.3 3.3 1.6-6.8L2.1 8.9 9 8.3 12 2Z';
---
<BaseLayout
  title="Reviews — Hero Pest Control | Trusted by the Neighborhood"
  description="Read 200+ verified 5-star reviews from Hero Pest Control customers across the region."
>
  <!-- ===== PAGE HEADER + RATING SUMMARY ===== -->
  <section class="relative overflow-hidden bg-ink py-20 text-white">
    <div class="absolute inset-0 ph"></div>
    <div class="absolute inset-0 bg-dots opacity-30"></div>
    <div class="relative mx-auto max-w-7xl px-4 text-center">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-400">Reviews</p>
      <h1 class="mt-2 font-display text-5xl font-extrabold tracking-tight">Trusted by the Neighborhood</h1>
      <div class="mt-6 inline-flex flex-wrap items-center justify-center gap-6 rounded-2xl border border-white/15 bg-white/10 px-8 py-5 backdrop-blur-sm">
        <div class="text-center">
          <p class="font-display text-5xl font-extrabold text-accent-400">5.0</p>
          <div class="mt-1 flex justify-center text-accent-500">{Array.from({ length: 5 }).map(() => <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d={star}></path></svg>)}</div>
        </div>
        <div class="h-14 w-px bg-white/20"></div>
        <div class="text-left text-sm"><p class="text-white/70">Based on <span class="font-bold text-white">200+ verified reviews</span></p><p class="mt-1 text-white/70">Across Google, Facebook &amp; Yelp</p></div>
      </div>
      <nav class="mt-6 flex justify-center gap-2 text-sm text-white/60" aria-label="Breadcrumb"><a href="/" class="hover:text-white">Home</a><span>/</span><span class="text-white">Reviews</span></nav>
    </div>
  </section>

  <!-- ===== REVIEW GRID ===== -->
  <section class="bg-mist py-20">
    <div class="mx-auto max-w-7xl px-4">
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          reviews.map((r, i) => (
            <figure class="flex h-full flex-col rounded-2xl border border-slate-100 bg-white p-7 shadow-soft reveal" x-intersect.once="$el.classList.add('shown')" style={`transition-delay:${(i % 3) * 70}ms`}>
              <div class="flex text-accent-500" aria-hidden="true">{Array.from({ length: r.stars }).map(() => <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d={star}></path></svg>)}</div>
              <blockquote class="mt-4 flex-1 text-[15px] leading-relaxed text-ink">“{r.text}”</blockquote>
              <figcaption class="mt-6 flex items-center gap-3 border-t border-slate-100 pt-5">
                <span class="grid h-11 w-11 place-items-center rounded-full bg-gradient-to-br from-brand-500 to-brand-700 font-display font-bold text-white">{r.name.charAt(0)}</span>
                <span><span class="block text-sm font-bold">{r.name}</span><span class="block text-xs text-slate-500">{r.location}</span></span>
                <span class="ml-auto rounded-full bg-brand-50 px-2.5 py-1 text-[10px] font-bold text-brand-700">Verified</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <Cta title="Join 2,000+ happy customers" text="Experience 5-star pest control for yourself." />
</BaseLayout>
