---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Cta from '../components/Cta.astro';
import Icon from '../components/Icon.astro';
import { reasons, stats } from '../data/site';

const values = [
  { title: 'Safety First', desc: 'Family- and pet-friendly treatments, applied by trained professionals who respect your space.', icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/>' },
  { title: 'Honesty &amp; Transparency', desc: 'Upfront pricing and straight answers. We recommend only what your home actually needs.', icon: '<path d="M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0Z"/><path d="M8 12l3 3 5-6"/>' },
  { title: 'Community &amp; Planet', desc: 'Locally owned and eco-conscious — protecting our neighbors and the environment we share.', icon: '<path d="M11 20A7 7 0 0 1 9 6c4-2 9-2 11 0 1 5-1 13-9 14Z"/>' },
];
---
<BaseLayout
  title="About Us — Hero Pest Control | Local, Licensed &amp; Trusted"
  description="Learn about Hero Pest Control — 15+ years of safe, effective, locally-owned pest control. Our mission, values, and certified team."
>
  <PageHeader
    eyebrow="About Hero"
    title="Protecting What Matters"
    subtitle="A locally-owned team on a mission to make pest control safe, honest, and genuinely effective."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'About Us' }]}
  />

  <!-- ===== STORY ===== -->
  <section class="bg-white py-20">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 lg:grid-cols-2">
      <div class="reveal" x-intersect.once="$el.classList.add('shown')">
        <img src="/img/about.svg" alt="Hero pest control team member at work" loading="lazy" class="aspect-[4/3] w-full rounded-3xl border border-slate-100 object-cover shadow-soft" />
      </div>
      <div class="reveal" x-intersect.once="$el.classList.add('shown')">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-600">Our Story</p>
        <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight">15+ years of dependable protection</h2>
        <p class="mt-4 text-slate-500">Hero Pest Control started with a simple belief: families and businesses deserve pest control that’s safe, effective, and honest. What began as a single truck and a promise has grown into a trusted local team serving 25+ cities.</p>
        <p class="mt-3 text-slate-500">We treat every home like our own — using proven, lower-impact methods, clear communication, and a guarantee that stands behind our work. No scare tactics, no hidden fees. Just results.</p>
        <div class="mt-7 grid grid-cols-3 gap-4">
          <div><p class="font-display text-3xl font-extrabold text-brand-700">15+</p><p class="text-xs font-semibold text-slate-500">Years</p></div>
          <div><p class="font-display text-3xl font-extrabold text-brand-700">2k+</p><p class="text-xs font-semibold text-slate-500">Customers</p></div>
          <div><p class="font-display text-3xl font-extrabold text-brand-700">100%</p><p class="text-xs font-semibold text-slate-500">Guaranteed</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== MISSION / VALUES ===== -->
  <section class="bg-mist py-20">
    <div class="mx-auto max-w-7xl px-4">
      <div class="mx-auto max-w-2xl text-center reveal" x-intersect.once="$el.classList.add('shown')">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-600">What We Stand For</p>
        <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Our values</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {
          values.map((v) => (
            <div class="rounded-2xl border border-slate-100 bg-white p-8 shadow-soft reveal" x-intersect.once="$el.classList.add('shown')">
              <div class="grid h-12 w-12 place-items-center rounded-xl bg-brand-50 text-brand-700"><Icon paths={v.icon} class="h-6 w-6" /></div>
              <h3 class="mt-5 text-lg font-bold" set:html={v.title} />
              <p class="mt-2 text-sm text-slate-500">{v.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== WHY CHOOSE US ===== -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4">
      <div class="mx-auto max-w-2xl text-center reveal" x-intersect.once="$el.classList.add('shown')">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-600">Why Hero</p>
        <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">The Hero difference</h2>
      </div>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          reasons.map((f, i) => (
            <div class="reveal" x-intersect.once="$el.classList.add('shown')" style={`transition-delay:${(i % 3) * 80}ms`}>
              <div class="group flex h-full items-start gap-4 rounded-2xl border border-slate-100 bg-white p-6 shadow-soft transition hover:-translate-y-1 hover:shadow-lift">
                <div class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 text-white"><Icon paths={f.icon} /></div>
                <div><h3 class="text-base font-bold">{f.title}</h3><p class="mt-1 text-sm text-slate-500">{f.desc}</p></div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== CERTIFICATIONS BAND ===== -->
  <section class="bg-ink py-16 text-white">
    <div class="mx-auto max-w-7xl px-4">
      <div class="grid grid-cols-2 gap-6 md:grid-cols-4">
        {
          stats.map((stat) => (
            <div class="text-center reveal" x-intersect.once="$el.classList.add('shown')">
              <p class="font-display text-4xl font-extrabold text-brand-400">{stat.value.toLocaleString()}{stat.suffix}</p>
              <p class="mt-1 text-sm font-semibold text-white/60">{stat.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Cta title="Ready for a pest-free home?" text="Book your free inspection today — no obligation." />
</BaseLayout>
