---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE, faqs } from '../data/site';

const inputClass =
  'w-full rounded-xl border border-slate-200 bg-mist px-4 py-3 text-sm outline-none transition focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-500/20';
---
<BaseLayout
  title="Contact — Hero Pest Control | Get a Free Quote"
  description="Tell us about your pest problem and get a fast, free, no-obligation quote from Hero Pest Control."
>
  <PageHeader
    eyebrow="Contact"
    title="Get a Free Quote"
    subtitle="Fast. Easy. No obligation. Tell us about your pest problem and we’ll take it from there."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Contact' }]}
  />

  <!-- ===== FORM + INFO ===== -->
  <section class="bg-mist py-20">
    <div class="mx-auto max-w-7xl px-4">
      <div class="grid gap-8 lg:grid-cols-2">
        <!-- Quote form -->
        <div class="reveal" x-intersect.once="$el.classList.add('shown')">
          <div class="rounded-3xl border border-slate-100 bg-white p-8 shadow-soft">
            <h2 class="font-display text-3xl font-extrabold tracking-tight">Request your free inspection</h2>
            <p class="mt-1 font-semibold text-brand-700">We typically respond within the hour.</p>
            <form x-data="quoteForm" @submit.prevent="submit()" class="mt-6 space-y-4" novalidate>
              <div x-show="sent" x-transition class="rounded-xl border border-brand-200 bg-brand-50 p-4 text-sm font-semibold text-brand-800">✅ Thanks! We’ve received your request and will call you shortly.</div>
              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <label for="name" class="sr-only">Full name</label>
                  <input id="name" x-model="f.name" @input="clear('name')" type="text" placeholder="Full Name" class={inputClass} />
                  <p x-show="e.name" x-text="e.name" class="mt-1 text-xs font-semibold text-red-500"></p>
                </div>
                <div>
                  <label for="phone" class="sr-only">Phone number</label>
                  <input id="phone" x-model="f.phone" @input="clear('phone')" type="tel" placeholder="Phone Number" class={inputClass} />
                  <p x-show="e.phone" x-text="e.phone" class="mt-1 text-xs font-semibold text-red-500"></p>
                </div>
                <div>
                  <label for="email" class="sr-only">Email address</label>
                  <input id="email" x-model="f.email" @input="clear('email')" type="email" placeholder="Email Address" class={inputClass} />
                  <p x-show="e.email" x-text="e.email" class="mt-1 text-xs font-semibold text-red-500"></p>
                </div>
                <div>
                  <label for="zip" class="sr-only">Zip code</label>
                  <input id="zip" x-model="f.zip" type="text" placeholder="Zip Code" class={inputClass} />
                </div>
              </div>
              <div>
                <label for="msg" class="sr-only">Tell us about your pest problem</label>
                <textarea id="msg" x-model="f.msg" rows="4" placeholder="Tell us about your pest problem…" class={inputClass}></textarea>
              </div>
              <button type="submit" class="w-full rounded-xl bg-gradient-to-r from-brand-600 to-brand-700 py-3.5 font-bold text-white shadow-lift transition hover:brightness-110">Submit Request</button>
              <p class="text-center text-xs text-slate-400">🔒 Your information is secure and never shared.</p>
            </form>
          </div>
        </div>

        <!-- Info + hours + map -->
        <div class="space-y-6 reveal" x-intersect.once="$el.classList.add('shown')">
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-soft">
              <div class="grid h-11 w-11 place-items-center rounded-xl bg-brand-50 text-brand-700"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"></path></svg></div>
              <p class="mt-3 text-xs font-bold uppercase tracking-wider text-slate-400">Call us</p>
              <a href={SITE.phoneHref} class="text-lg font-bold transition hover:text-brand-700">{SITE.phone}</a>
            </div>
            <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-soft">
              <div class="grid h-11 w-11 place-items-center rounded-xl bg-brand-50 text-brand-700"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg></div>
              <p class="mt-3 text-xs font-bold uppercase tracking-wider text-slate-400">Email</p>
              <a href={`mailto:${SITE.email}`} class="break-all text-sm font-bold transition hover:text-brand-700">{SITE.email}</a>
            </div>
          </div>

          <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-soft">
            <h3 class="flex items-center gap-2 font-bold"><svg class="h-5 w-5 text-brand-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2" stroke-linecap="round"></path></svg> Service Hours</h3>
            <dl class="mt-4 space-y-2 text-sm">
              <div class="flex justify-between"><dt class="text-slate-500">Mon – Fri</dt><dd class="font-semibold">7:00 AM – 7:00 PM</dd></div>
              <div class="flex justify-between"><dt class="text-slate-500">Saturday</dt><dd class="font-semibold">8:00 AM – 5:00 PM</dd></div>
              <div class="flex justify-between"><dt class="text-slate-500">Sunday</dt><dd class="font-semibold text-brand-700">Emergency only</dd></div>
            </dl>
          </div>

          <div class="ph-light relative h-56 overflow-hidden rounded-2xl border border-slate-200 shadow-soft">
            <div class="absolute inset-0 bg-dots opacity-60"></div>
            <div class="absolute inset-0 grid place-items-center"><span class="rounded-full bg-white/80 px-4 py-2 text-sm font-bold text-brand-700 shadow-sm backdrop-blur-sm">📍 Embedded Map Placeholder</span></div>
            <span class="absolute left-1/3 top-1/3 h-3 w-3 rounded-full bg-brand-600 ring-4 ring-brand-600/30"></span>
            <span class="absolute left-2/3 top-1/2 h-3 w-3 rounded-full bg-accent-500 ring-4 ring-accent-500/30"></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-3xl px-4">
      <div class="text-center reveal" x-intersect.once="$el.classList.add('shown')">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-600">FAQ</p>
        <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Questions, answered</h2>
      </div>
      <div x-data="{ open:0 }" class="mt-12 space-y-3">
        {
          faqs.map((f, i) => (
            <div class="overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-soft reveal" x-intersect.once="$el.classList.add('shown')">
              <button @click={`open = (open===${i} ? null : ${i})`} :aria-expanded={`open===${i}`} class="flex w-full items-center justify-between gap-4 px-6 py-5 text-left">
                <span class="text-base font-bold">{f.q}</span>
                <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-brand-50 text-brand-700 transition" :class={`open===${i} && 'rotate-45'`}><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg></span>
              </button>
              <div x-show={`open===${i}`} x-collapse><p class="px-6 pb-5 text-slate-500">{f.a}</p></div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
