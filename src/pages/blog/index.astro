---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Cta from '../../components/Cta.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = posts[0];
const rest = posts.slice(1);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<BaseLayout
  title="Blog — Hero Pest Control | Pest Control Insights"
  description="Expert pest control tips, prevention guides, and straight answers to help you protect your home and family."
>
  <PageHeader
    eyebrow="The Hero Blog"
    title="Pest Control Insights"
    subtitle="Expert tips, prevention guides, and straight answers to help you protect your home and family."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Blog' }]}
  />

  <!-- ===== FEATURED POST ===== -->
  <section class="bg-white pt-16">
    <div class="mx-auto max-w-7xl px-4">
      <a href={`/blog/${featured.id}`} class="group grid items-center gap-8 overflow-hidden rounded-3xl border border-slate-100 bg-white shadow-soft transition hover:shadow-lift lg:grid-cols-2 reveal" x-intersect.once="$el.classList.add('shown')">
        <div class="relative h-64 overflow-hidden lg:h-full">
          <img src={featured.data.img} alt={featured.data.title} class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
          <span class="absolute left-4 top-4 rounded-full bg-white/90 px-3 py-1 text-xs font-bold uppercase tracking-wide text-brand-700 backdrop-blur-sm">{featured.data.category}</span>
        </div>
        <div class="p-8 lg:p-10">
          <span class="text-xs font-bold uppercase tracking-wider text-brand-600">Featured</span>
          <h2 class="mt-2 font-display text-3xl font-extrabold leading-tight tracking-tight group-hover:text-brand-700">{featured.data.title}</h2>
          <p class="mt-3 text-slate-500">{featured.data.excerpt}</p>
          <p class="mt-4 text-sm text-slate-400">{fmt(featured.data.pubDate)} · {featured.data.read}</p>
          <span class="mt-6 inline-flex items-center gap-1.5 font-bold text-brand-700">Read article
            <svg class="h-4 w-4 transition group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </span>
        </div>
      </a>
    </div>
  </section>

  <!-- ===== POST GRID ===== -->
  <section class="bg-white py-16">
    <div class="mx-auto max-w-7xl px-4">
      <h2 class="mb-8 font-display text-2xl font-extrabold tracking-tight">Latest articles</h2>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-2">
        {
          rest.map((p, i) => (
            <a href={`/blog/${p.id}`} class="group flex flex-col overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-soft transition hover:-translate-y-1 hover:shadow-lift reveal sm:flex-row" x-intersect.once="$el.classList.add('shown')" style={`transition-delay:${(i % 2) * 80}ms`}>
              <div class="relative h-48 overflow-hidden sm:h-auto sm:w-2/5">
                <img src={p.data.img} alt={p.data.title} loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
                <span class="absolute left-3 top-3 rounded-full bg-white/90 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-brand-700 backdrop-blur-sm">{p.data.category}</span>
              </div>
              <div class="flex flex-1 flex-col p-6">
                <p class="text-xs text-slate-400">{fmt(p.data.pubDate)} · {p.data.read}</p>
                <h3 class="mt-1.5 font-display text-lg font-extrabold leading-snug group-hover:text-brand-700">{p.data.title}</h3>
                <p class="mt-2 flex-1 text-sm text-slate-500">{p.data.excerpt}</p>
                <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-brand-700">Read more
                  <svg class="h-4 w-4 transition group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <Cta title="Got a pest problem right now?" text="Skip the reading — get a free inspection from our team today." />
</BaseLayout>
