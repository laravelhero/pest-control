---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cta from '../../components/Cta.astro';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, related: posts.filter((p) => p.id !== entry.id).slice(0, 3) },
  }));
}

const { entry, related } = Astro.props;
const p = entry.data;
const { Content } = await render(entry);

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<BaseLayout title={`${p.title} — Hero Pest Control Blog`} description={p.excerpt}>
  <!-- hero -->
  <section class="relative overflow-hidden bg-ink py-20 text-white">
    <div class="absolute inset-0 ph"></div><div class="absolute inset-0 bg-dots opacity-30"></div>
    <div class="relative mx-auto max-w-3xl px-4 text-center">
      <nav class="flex justify-center gap-2 text-sm text-white/60" aria-label="Breadcrumb"><a href="/" class="hover:text-white">Home</a><span>/</span><a href="/blog" class="hover:text-white">Blog</a><span>/</span><span class="text-white">{p.category}</span></nav>
      <span class="mt-6 inline-flex rounded-full bg-brand-500/20 px-3 py-1 text-xs font-bold uppercase tracking-wide text-brand-300">{p.category}</span>
      <h1 class="mt-4 font-display text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">{p.title}</h1>
      <p class="mt-4 text-sm text-white/60">{fmt(p.pubDate)} · {p.read}</p>
    </div>
  </section>

  <!-- article -->
  <article class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-4">
      <img src={p.img} alt={p.title} class="aspect-[16/9] w-full rounded-3xl border border-slate-100 object-cover shadow-soft" />
      <div class="post-body mt-10"><Content /></div>

      <div class="mt-12 flex flex-col items-start justify-between gap-4 rounded-2xl border border-slate-100 bg-mist p-6 shadow-soft sm:flex-row sm:items-center">
        <div class="flex items-center gap-3">
          <span class="grid h-12 w-12 place-items-center rounded-full bg-gradient-to-br from-brand-500 to-brand-700 font-display text-lg font-bold text-white">{SITE.name.charAt(0)}</span>
          <div><p class="font-bold">{SITE.name}</p><p class="text-sm text-slate-500">Licensed &amp; insured pest experts</p></div>
        </div>
        <a href="/contact" class="rounded-full bg-gradient-to-r from-brand-600 to-brand-700 px-6 py-3 text-sm font-bold text-white shadow-lift transition hover:brightness-110">Get a Free Estimate</a>
      </div>
    </div>
  </article>

  <!-- related -->
  <section class="bg-mist py-16">
    <div class="mx-auto max-w-7xl px-4">
      <div class="flex items-end justify-between"><h2 class="font-display text-3xl font-extrabold tracking-tight">Keep reading</h2><a href="/blog" class="text-sm font-bold text-brand-700">All posts →</a></div>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {related.map((r) => (
          <a href={`/blog/${r.id}`} class="group overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-soft transition hover:-translate-y-1 hover:shadow-lift">
            <div class="relative h-40 overflow-hidden"><img src={r.data.img} alt={r.data.title} loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" /><span class="absolute left-3 top-3 rounded-full bg-white/90 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-brand-700 backdrop-blur-sm">{r.data.category}</span></div>
            <div class="p-5"><p class="text-xs text-slate-400">{fmt(r.data.pubDate)} · {r.data.read}</p><h3 class="mt-1.5 font-bold leading-snug group-hover:text-brand-700">{r.data.title}</h3></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Cta title="Dealing with a pest problem?" text="Our team is ready to help — book a free inspection today." cta="Free Estimate" />
</BaseLayout>
