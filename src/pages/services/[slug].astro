---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cta from '../../components/Cta.astro';
import { steps, SITE } from '../../data/site';

export async function getStaticPaths() {
  const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
  return services.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, related: services.filter((s) => s.id !== entry.id) },
  }));
}

const { entry, related } = Astro.props;
const s = entry.data;
const nameLower = s.name.toLowerCase();
---
<BaseLayout title={`${s.name} — Hero Pest Control`} description={s.tagline}>
  <!-- hero -->
  <section class="relative overflow-hidden bg-ink py-20 text-white">
    <div class="absolute inset-0 ph"></div><div class="absolute inset-0 bg-dots opacity-30"></div>
    <div class="relative mx-auto max-w-7xl px-4">
      <nav class="flex gap-2 text-sm text-white/60" aria-label="Breadcrumb"><a href="/" class="hover:text-white">Home</a><span>/</span><a href="/services" class="hover:text-white">Services</a><span>/</span><span class="text-white">{s.name}</span></nav>
      <div class="mt-6 grid items-center gap-10 lg:grid-cols-2">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-bold backdrop-blur-sm"><span class="grid h-5 w-5 place-items-center text-brand-300"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg></span> Licensed &amp; Insured · Guaranteed</span>
          <h1 class="mt-5 font-display text-5xl font-extrabold leading-tight tracking-tight">{s.name}</h1>
          <p class="mt-4 max-w-md text-lg text-white/75">{s.tagline}</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="/contact" class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-brand-500 to-brand-600 px-7 py-3.5 font-bold text-white shadow-lift transition hover:brightness-110">Free Estimate <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
            <a href={SITE.phoneHref} class="inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/5 px-7 py-3.5 font-bold backdrop-blur-sm transition hover:bg-white/15">Call {SITE.phone}</a>
          </div>
        </div>
        <div class="reveal" x-intersect.once="$el.classList.add('shown')"><img src={s.img} alt={s.name} class="aspect-[4/3] w-full rounded-3xl border border-white/10 object-cover shadow-glow" /></div>
      </div>
    </div>
  </section>

  <!-- overview -->
  <section class="bg-white py-20">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 lg:grid-cols-2">
      <div class="reveal" x-intersect.once="$el.classList.add('shown')">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-600">Overview</p>
        <h2 class="mt-2 font-display text-3xl font-extrabold tracking-tight">About our {nameLower}</h2>
        <p class="mt-4 text-slate-500">{s.long}</p>
        <h3 class="mt-8 font-bold">How we treat it</h3>
        <ul class="mt-3 space-y-2.5">
          {s.treatment.map((t) => (
            <li class="flex items-start gap-2.5 text-slate-600"><span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-brand-100 text-brand-700"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg></span><span>{t}</span></li>
          ))}
        </ul>
      </div>
      <div class="reveal" x-intersect.once="$el.classList.add('shown')">
        <div class="rounded-3xl border border-slate-100 bg-mist p-8 shadow-soft">
          <h3 class="font-display text-xl font-extrabold">Signs you may have a problem</h3>
          <ul class="mt-4 space-y-2.5">
            {s.signs.map((t) => (
              <li class="flex items-start gap-2.5 text-slate-600"><span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-amber-50 text-accent-600"><svg class="h-4 w-4 text-accent-500" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="5"></circle></svg></span><span>{t}</span></li>
            ))}
          </ul>
          <a href="/contact" class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-brand-600 to-brand-700 py-3.5 font-bold text-white shadow-lift transition hover:brightness-110">Get a Free Inspection</a>
        </div>
      </div>
    </div>
  </section>

  <!-- process -->
  <section class="bg-ink py-20 text-white">
    <div class="mx-auto max-w-7xl px-4">
      <div class="mx-auto max-w-2xl text-center reveal" x-intersect.once="$el.classList.add('shown')">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-400">How It Works</p>
        <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight">Our proven {nameLower} process</h2>
      </div>
      <div class="relative mt-16"><div class="absolute left-0 right-0 top-7 hidden h-px bg-gradient-to-r from-transparent via-brand-500/50 to-transparent lg:block"></div>
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-5">
          {steps.map((st, i) => (
            <div class="relative text-center reveal" x-intersect.once="$el.classList.add('shown')">
              <div class="relative z-10 mx-auto grid h-14 w-14 place-items-center rounded-2xl border border-white/15 bg-white/5 backdrop-blur-sm"><span class="font-display text-lg font-extrabold text-brand-400">0{i + 1}</span></div>
              <h3 class="mt-4 text-base font-bold">{st.title}</h3>
              <p class="mx-auto mt-1.5 max-w-[12rem] text-sm text-white/55">{st.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- benefits -->
  <section class="bg-mist py-20">
    <div class="mx-auto max-w-7xl px-4">
      <div class="mx-auto max-w-2xl text-center reveal" x-intersect.once="$el.classList.add('shown')">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-600">Why Hero</p>
        <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight">What you get</h2>
      </div>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {s.benefits.map((b) => (
          <div class="flex items-center gap-3 rounded-2xl border border-slate-100 bg-white p-5 shadow-soft">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 text-white"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg></span>
            <span class="text-sm font-bold">{b}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- related -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4">
      <div class="flex items-end justify-between"><h2 class="font-display text-3xl font-extrabold tracking-tight">Other services</h2><a href="/services" class="text-sm font-bold text-brand-700">View all →</a></div>
      <div class="mt-8 grid gap-5 sm:grid-cols-3 lg:grid-cols-5">
        {related.map((r) => (
          <a href={`/services/${r.id}`} class="group overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-soft transition hover:-translate-y-1 hover:shadow-lift">
            <div class="relative h-28 overflow-hidden"><img src={r.data.img} alt={r.data.name} loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" /><div class="absolute inset-0 bg-gradient-to-t from-ink/55 to-transparent"></div></div>
            <div class="flex items-center justify-between p-4"><span class="text-sm font-bold">{r.data.name}</span><svg class="h-4 w-4 text-brand-700 transition group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Cta title={`Ready to solve your ${nameLower} problem?`} text="Get a free, no-obligation estimate today." cta="Free Estimate" />
</BaseLayout>
