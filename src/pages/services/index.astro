---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Cta from '../../components/Cta.astro';
import Icon from '../../components/Icon.astro';
import { steps, featured } from '../../data/site';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title="Our Services — Hero Pest Control | Complete Pest Solutions"
  description="From a single nuisance to a full infestation — Hero offers safe, guaranteed pest control treatments for homes and businesses."
>
  <PageHeader
    eyebrow="Our Services"
    title="Complete Pest Solutions"
    subtitle="From a single nuisance to a full infestation — we have a safe, guaranteed treatment for it."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Services' }]}
  />

  <!-- ===== SERVICE CARDS ===== -->
  <section class="bg-mist py-20">
    <div class="mx-auto max-w-7xl px-4">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((s, i) => (
            <div id={s.id} class="reveal scroll-mt-28" x-intersect.once="$el.classList.add('shown')" style={`transition-delay:${(i % 3) * 80}ms`}>
              <article class="group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-soft transition duration-300 hover:-translate-y-1.5 hover:border-brand-200 hover:shadow-lift">
                <div class="relative h-44 overflow-hidden">
                  <img src={s.data.img} alt={s.data.name} loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
                  <div class="absolute inset-0 bg-gradient-to-t from-ink/60 to-transparent" />
                  <span class="absolute bottom-3 left-3 grid h-11 w-11 place-items-center rounded-xl bg-white/90 text-brand-700 backdrop-blur-sm"><Icon paths={s.data.icon} /></span>
                </div>
                <div class="flex flex-1 flex-col p-6">
                  <h3 class="text-lg font-bold">{s.data.name}</h3>
                  <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-500">{s.data.desc}</p>
                  <div class="mt-5 grid grid-cols-2 gap-2.5">
                    <a href={`/services/${s.id}`} class="inline-flex items-center justify-center gap-1.5 rounded-full border border-slate-200 px-4 py-2.5 text-sm font-bold text-ink transition hover:border-brand-300 hover:text-brand-700">Learn More</a>
                    <a href="/contact" class="inline-flex items-center justify-center gap-1.5 rounded-full bg-gradient-to-r from-brand-600 to-brand-700 px-4 py-2.5 text-sm font-bold text-white shadow-lift transition hover:brightness-110">Free Estimate</a>
                  </div>
                </div>
              </article>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== PROCESS ===== -->
  <section class="bg-ink py-20 text-white">
    <div class="mx-auto max-w-7xl px-4">
      <div class="mx-auto max-w-2xl text-center reveal" x-intersect.once="$el.classList.add('shown')">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-400">How It Works</p>
        <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Our Proven 5-Step Process</h2>
      </div>
      <div class="relative mt-16">
        <div class="absolute left-0 right-0 top-7 hidden h-px bg-gradient-to-r from-transparent via-brand-500/50 to-transparent lg:block"></div>
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-5">
          {
            steps.map((step, i) => (
              <div class="relative text-center reveal" x-intersect.once="$el.classList.add('shown')" style={`transition-delay:${i * 90}ms`}>
                <div class="relative z-10 mx-auto grid h-14 w-14 place-items-center rounded-2xl border border-white/15 bg-white/5 backdrop-blur-sm"><span class="font-display text-lg font-extrabold text-brand-400">0{i + 1}</span></div>
                <h3 class="mt-4 text-base font-bold">{step.title}</h3>
                <p class="mx-auto mt-1.5 max-w-[12rem] text-sm text-white/55">{step.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FEATURED ===== -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl space-y-16 px-4">
      <div class="mx-auto max-w-2xl text-center reveal" x-intersect.once="$el.classList.add('shown')">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-600">Featured Programs</p>
        <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Programs built around your home</h2>
      </div>
      {
        featured.map((feat, i) => (
          <div class="grid items-center gap-10 lg:grid-cols-2 reveal" x-intersect.once="$el.classList.add('shown')">
            <div class={i % 2 === 1 ? 'lg:order-2' : ''}><img src={feat.img} alt={feat.name} loading="lazy" class="aspect-[16/11] w-full rounded-3xl border border-slate-100 object-cover shadow-soft" /></div>
            <div class={i % 2 === 1 ? 'lg:order-1' : ''}>
              <span class="inline-flex rounded-full bg-brand-50 px-3 py-1 text-xs font-bold text-brand-700">{feat.tag}</span>
              <h3 class="mt-4 font-display text-3xl font-extrabold tracking-tight">{feat.name}</h3>
              <p class="mt-3 text-slate-500">{feat.desc}</p>
              <ul class="mt-5 space-y-2.5">
                {feat.points.map((point) => (
                  <li class="flex items-center gap-2.5 text-sm font-semibold text-ink"><span class="grid h-5 w-5 place-items-center rounded-full bg-brand-100 text-brand-700"><svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg></span><span>{point}</span></li>
                ))}
              </ul>
              <a href="/contact" class="mt-7 inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-brand-600 to-brand-700 px-6 py-3 font-bold text-white shadow-lift transition hover:brightness-110">Get This Service</a>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <Cta title="Not sure which service you need?" text="Get a free inspection and we’ll build the right plan for you." cta="Book Free Inspection" />
</BaseLayout>
