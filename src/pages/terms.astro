---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Cta from '../components/Cta.astro';
import { SITE } from '../data/site';

const sections = [
  { id: 'acceptance', title: '1. Acceptance of Terms', paragraphs: ['By accessing our website or using our services, you confirm that you are at least 18 years old and able to enter into a binding agreement. If you do not agree to these Terms, please do not use our website or services.'] },
  { id: 'services', title: '2. Our Services', paragraphs: ['Hero provides residential and commercial pest control, inspection, and prevention services. The specific scope, frequency, and treatments are described in the quote or service agreement you receive. We may use licensed, lower-impact products and methods, and results can vary depending on the property, pest type, and environmental conditions.'] },
  { id: 'quotes', title: '3. Quotes & Pricing', paragraphs: ['Quotes and estimates are based on the information you provide and conditions observed at the time of inspection. Pricing may be adjusted if actual conditions differ — for example, severity of infestation, property size, or access. We will communicate any material changes before performing additional work.'] },
  { id: 'scheduling', title: '4. Scheduling & Cancellations', paragraphs: ['You are responsible for providing safe and reasonable access to the property at the scheduled time. If you need to reschedule or cancel, please give us at least 24 hours’ notice. Missed appointments or cancellations without adequate notice may be subject to a service fee.'] },
  { id: 'payment', title: '5. Payment Terms', paragraphs: ['Payment is due upon completion of service unless otherwise agreed in writing. We accept the payment methods listed at the time of booking. Recurring plans renew automatically until cancelled. Late or unpaid balances may incur fees and may result in suspension of service.'] },
  { id: 'guarantee', title: '6. Service Guarantee', paragraphs: ['We stand behind our work. If covered pests return between scheduled treatments on an eligible plan, we will re-treat the affected areas at no additional charge. Guarantee details, covered pests, and any exclusions are described in your service agreement.'] },
  {
    id: 'responsibilities',
    title: '7. Customer Responsibilities',
    intro: 'To help ensure safe and effective service, you agree to:',
    bullets: [
      'Disclose known hazards, pets, allergies, or sensitivities before treatment;',
      'Follow any preparation and re-entry instructions we provide;',
      'Keep children and pets away from treated areas as directed;',
      'Provide accurate information about the property and pest concerns.',
    ],
  },
  { id: 'warranties', title: '8. Warranties & Disclaimers', paragraphs: ['Except as expressly stated in your service agreement or guarantee, our services are provided “as is.” We do not warrant that any treatment will result in permanent or complete elimination of pests, as reinfestation can occur due to factors beyond our control.'] },
  { id: 'liability', title: '9. Limitation of Liability', paragraphs: ['To the fullest extent permitted by law, Hero shall not be liable for indirect, incidental, or consequential damages arising from the use of our website or services. Our total liability for any claim shall not exceed the amount you paid for the specific service giving rise to the claim.'] },
  { id: 'ip', title: '10. Intellectual Property', paragraphs: ['All content on this website — including text, graphics, logos, and images — is the property of Hero Pest Control or its licensors and is protected by applicable laws. You may not reproduce or distribute it without our written permission.'] },
  { id: 'law', title: '11. Governing Law', paragraphs: ['These Terms are governed by the laws of the state in which Hero operates, without regard to conflict-of-law principles. Any disputes shall be resolved in the courts located in that jurisdiction.'] },
  { id: 'changes', title: '12. Changes to These Terms', paragraphs: ['We may update these Terms from time to time. Changes take effect when posted, and we will revise the “Last updated” date above. Your continued use of our website or services after changes are posted constitutes acceptance of the updated Terms.'] },
];

const toc = [
  ['#acceptance', '1. Acceptance of Terms'],
  ['#services', '2. Our Services'],
  ['#quotes', '3. Quotes & Pricing'],
  ['#scheduling', '4. Scheduling & Cancellations'],
  ['#payment', '5. Payment Terms'],
  ['#guarantee', '6. Service Guarantee'],
  ['#responsibilities', '7. Customer Responsibilities'],
  ['#warranties', '8. Warranties & Disclaimers'],
  ['#liability', '9. Limitation of Liability'],
  ['#ip', '10. Intellectual Property'],
  ['#law', '11. Governing Law'],
  ['#changes', '12. Changes to These Terms'],
  ['#contact', '13. Contact Us'],
];
---
<BaseLayout title="Terms of Service — Hero Pest Control" description="The terms and conditions that govern your use of Hero Pest Control's website and services.">
  <PageHeader
    eyebrow="Legal"
    title="Terms of Service"
    subtitle="The terms that govern your use of our website and pest control services."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Terms of Service' }]}
  />

  <section class="bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-4">
      <p class="inline-flex items-center gap-2 rounded-full bg-brand-50 px-4 py-1.5 text-sm font-semibold text-brand-700">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path></svg>
        Last updated: June 7, 2026
      </p>

      <p class="mt-6 text-lg leading-relaxed text-slate-600">These Terms of Service (“Terms”) govern your access to and use of the website and pest control services provided by Hero Pest Control (“Hero,” “we,” “us,” or “our”). By using our website, requesting a quote, or booking a service, you agree to these Terms. Please read them carefully.</p>

      <nav class="mt-8 rounded-2xl border border-slate-100 bg-mist p-6 shadow-soft" aria-label="On this page">
        <p class="text-sm font-bold uppercase tracking-wider text-slate-400">On this page</p>
        <ol class="mt-3 grid gap-2 text-sm font-semibold text-brand-700 sm:grid-cols-2">
          {toc.map(([href, label]) => <li><a href={href} class="hover:underline">{label}</a></li>)}
        </ol>
      </nav>

      <div class="mt-12 space-y-12">
        {
          sections.map((s) => (
            <section id={s.id} class="scroll-mt-28 reveal" x-intersect.once="$el.classList.add('shown')">
              <h2 class="font-display text-2xl font-extrabold tracking-tight">{s.title}</h2>
              {s.intro && <p class="mt-3 leading-relaxed text-slate-600">{s.intro}</p>}
              {s.paragraphs?.map((p) => <p class="mt-3 leading-relaxed text-slate-600">{p}</p>)}
              {s.bullets && (
                <ul class="mt-4 space-y-2 pl-5 leading-relaxed text-slate-600 [list-style:disc]">
                  {s.bullets.map((b) => <li>{b}</li>)}
                </ul>
              )}
            </section>
          ))
        }

        <section id="contact" class="scroll-mt-28 reveal" x-intersect.once="$el.classList.add('shown')">
          <h2 class="font-display text-2xl font-extrabold tracking-tight">13. Contact Us</h2>
          <p class="mt-3 leading-relaxed text-slate-600">If you have questions about these Terms, please contact us:</p>
          <div class="mt-5 rounded-2xl border border-slate-100 bg-mist p-6 text-sm text-slate-600 shadow-soft">
            <p class="font-bold text-ink">{SITE.name}</p>
            <p class="mt-2 flex items-center gap-2"><svg class="h-4 w-4 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.4-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2Z"></path></svg> {SITE.phone}</p>
            <p class="mt-2 flex items-center gap-2"><svg class="h-4 w-4 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg> {SITE.email}</p>
          </div>
        </section>
      </div>
    </div>
  </section>

  <Cta title="Ready for a pest-free home?" text="Book your free inspection today — no obligation." />
</BaseLayout>
