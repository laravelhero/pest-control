---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE, stats, reasons, steps, featured, reviews } from '../data/site';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const star = 'm12 2 3 6.3 6.9.6-5.2 4.6 1.6 6.8L12 17l-6.3 3.3 1.6-6.8L2.1 8.9 9 8.3 12 2Z';

const carouselData = `{ active:0, count:${reviews.length}, t:null, start(){ this.t=setInterval(()=>this.next(),6000) }, stop(){ clearInterval(this.t) }, next(){ this.active=(this.active+1)%this.count }, prev(){ this.active=(this.active-1+this.count)%this.count } }`;
---
<BaseLayout
  title="Hero Pest Control — Pest Control You Can Trust | Free Inspection"
  description="Premium local pest control for homes & businesses. Licensed & insured technicians, eco-friendly treatments, same-day service. Get a free inspection."
>
  <!-- ===== HERO ===== -->
  <section class="relative overflow-hidden bg-ink text-white">
    <div class="absolute inset-0 ph"></div>
    <div class="absolute inset-0 bg-dots opacity-30"></div>
    <div class="absolute -left-32 top-10 h-96 w-96 rounded-full bg-brand-500/30 blur-3xl"></div>
    <div class="absolute -right-20 bottom-0 h-96 w-96 rounded-full bg-brand-700/40 blur-3xl"></div>

    <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-4 py-16 lg:grid-cols-2 lg:py-24">
      <div class="reveal" x-intersect.once="$el.classList.add('shown')">
        <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-bold backdrop-blur-sm">
          <svg class="h-4 w-4 text-accent-400" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 4 5v6c0 5 3.4 9.3 8 11 4.6-1.7 8-6 8-11V5l-8-3Z"></path></svg>
          Licensed &amp; Insured · 15+ Years Protecting Homes
        </span>
        <h1 class="mt-6 font-display text-5xl font-extrabold leading-[1.05] tracking-tight sm:text-6xl">
          Pest Control<br /><span class="bg-gradient-to-r from-brand-400 to-brand-200 bg-clip-text text-transparent">You Can Trust.</span>
        </h1>
        <p class="mt-5 max-w-md text-lg text-white/75">Local. Reliable. Effective. We protect your home and business with safe, proven solutions that actually last.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact" class="group inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-brand-500 to-brand-600 px-7 py-3.5 font-bold text-white shadow-lift transition hover:brightness-110">
            Schedule Service
            <svg class="h-5 w-5 transition group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
          <a href="/contact" class="inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/5 px-7 py-3.5 font-bold backdrop-blur-sm transition hover:bg-white/15">Get a Free Quote</a>
        </div>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
          <div class="flex items-center gap-2">
            <span class="grid h-9 w-9 place-items-center rounded-full bg-brand-500/20 text-brand-300"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg></span>
            <span class="text-sm font-bold">Licensed &amp; Insured</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="flex text-accent-500" aria-label="5 out of 5 stars">{Array.from({ length: 5 }).map(() => <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d={star}></path></svg>)}</div>
            <span class="text-sm font-bold">5.0 <span class="font-medium text-white/60">(200+ Reviews)</span></span>
          </div>
        </div>
      </div>

      <div class="relative reveal" x-intersect.once="$el.classList.add('shown')">
        <img src="/img/photo-hero.jpg" alt="Hero pest control technician at a customer's home" loading="eager" class="aspect-[4/5] w-full rounded-[2rem] border border-white/10 object-cover shadow-glow" />
        <div class="absolute -left-4 top-10 animate-float rounded-2xl border border-white/15 bg-white/10 p-4 shadow-glow backdrop-blur-md sm:-left-8">
          <p class="font-display text-2xl font-extrabold text-white">15+</p><p class="text-xs font-semibold text-white/70">Years Experience</p>
        </div>
        <div class="absolute -right-3 top-1/3 animate-float-slow rounded-2xl border border-white/15 bg-white/10 p-4 shadow-glow backdrop-blur-md">
          <p class="font-display text-2xl font-extrabold text-brand-300">Same Day</p><p class="text-xs font-semibold text-white/70">Service Available</p>
        </div>
        <div class="absolute -bottom-4 left-6 animate-float-slow rounded-2xl border border-white/15 bg-white/10 p-4 shadow-glow backdrop-blur-md">
          <div class="flex text-accent-500">{Array.from({ length: 5 }).map(() => <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d={star}></path></svg>)}</div>
          <p class="mt-1 text-xs font-semibold text-white/70">5-Star Rated Service</p>
        </div>
      </div>
    </div>
    <svg class="relative block w-full" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true"><path fill="#ffffff" d="M0 80h1440V0c-240 53-480 53-720 26S240-7 0 26v54Z"></path></svg>
  </section>

  <!-- ===== STATS ===== -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-12">
      <div class="grid grid-cols-2 gap-6 rounded-3xl border border-slate-100 bg-mist p-8 shadow-soft md:grid-cols-4">
        {
          stats.map((stat) => (
            <div class="text-center reveal" x-intersect.once="$el.classList.add('shown')">
              <div class="font-display text-4xl font-extrabold text-brand-700" x-data="{ n:0 }" x-intersect.once={`let t=setInterval(()=>{ n=Math.min(${stat.value}, n + Math.ceil(${stat.value}/45)); if(n>=${stat.value}) clearInterval(t) }, 22)`}>
                <span x-text="n.toLocaleString()">0</span><span>{stat.suffix}</span>
              </div>
              <p class="mt-1 text-sm font-semibold text-slate-500">{stat.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== SERVICES ===== -->
  <section class="bg-mist py-20">
    <div class="mx-auto max-w-7xl px-4">
      <div class="mx-auto max-w-2xl text-center reveal" x-intersect.once="$el.classList.add('shown')">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-600">Our Services</p>
        <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Complete Protection for Home &amp; Business</h2>
        <p class="mt-4 text-lg text-slate-500">One team for every pest problem — backed by a satisfaction guarantee.</p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((s, i) => (
            <div class="reveal" x-intersect.once="$el.classList.add('shown')" style={`transition-delay:${(i % 3) * 80}ms`}>
              <article class="group h-full overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-soft transition duration-300 hover:-translate-y-1.5 hover:border-brand-200 hover:shadow-lift">
                <div class="relative h-40 overflow-hidden">
                  <img src={s.data.img} alt={s.data.name} loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
                  <div class="absolute inset-0 bg-gradient-to-t from-ink/60 to-transparent" />
                  <span class="absolute bottom-3 left-3 grid h-11 w-11 place-items-center rounded-xl bg-white/90 text-brand-700 backdrop-blur-sm"><Icon paths={s.data.icon} /></span>
                </div>
                <div class="p-6">
                  <h3 class="text-lg font-bold">{s.data.name}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-slate-500">{s.data.desc}</p>
                  <a href={`/services/${s.id}`} class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-brand-700">Learn More
                    <svg class="h-4 w-4 transition group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
                </div>
              </article>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== WHY CHOOSE US ===== -->
  <section class="relative overflow-hidden bg-white py-20">
    <div class="absolute -right-40 top-20 h-80 w-80 rounded-full bg-brand-50 blur-3xl"></div>
    <div class="relative mx-auto max-w-7xl px-4">
      <div class="grid gap-12 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-4 reveal" x-intersect.once="$el.classList.add('shown')">
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-600">Why Hero</p>
          <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Why homeowners <span class="text-brand-600">choose us</span></h2>
          <p class="mt-4 text-lg text-slate-500">We combine local care with professional-grade results — and stand behind every treatment.</p>
          <a href="/about" class="mt-7 inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-brand-600 to-brand-700 px-6 py-3 font-bold text-white shadow-lift transition hover:brightness-110">More About Us</a>
        </div>
        <div class="grid gap-5 sm:grid-cols-2 lg:col-span-8">
          {
            reasons.map((f, i) => (
              <div class="reveal" x-intersect.once="$el.classList.add('shown')" style={`transition-delay:${(i % 2) * 80}ms`}>
                <div class="group flex h-full items-start gap-4 rounded-2xl border border-slate-100 bg-white p-6 shadow-soft transition hover:-translate-y-1 hover:shadow-lift">
                  <div class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 text-white"><Icon paths={f.icon} /></div>
                  <div><h3 class="text-base font-bold">{f.title}</h3><p class="mt-1 text-sm text-slate-500">{f.desc}</p></div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PROCESS ===== -->
  <section class="bg-ink py-20 text-white">
    <div class="mx-auto max-w-7xl px-4">
      <div class="mx-auto max-w-2xl text-center reveal" x-intersect.once="$el.classList.add('shown')">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-400">How It Works</p>
        <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Our Proven 5-Step Process</h2>
      </div>
      <div class="relative mt-16">
        <div class="absolute left-0 right-0 top-7 hidden h-px bg-gradient-to-r from-transparent via-brand-500/50 to-transparent lg:block"></div>
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-5">
          {
            steps.map((step, i) => (
              <div class="relative text-center reveal" x-intersect.once="$el.classList.add('shown')" style={`transition-delay:${i * 90}ms`}>
                <div class="relative z-10 mx-auto grid h-14 w-14 place-items-center rounded-2xl border border-white/15 bg-white/5 backdrop-blur-sm"><span class="font-display text-lg font-extrabold text-brand-400">0{i + 1}</span></div>
                <h3 class="mt-4 text-base font-bold">{step.title}</h3>
                <p class="mx-auto mt-1.5 max-w-[12rem] text-sm text-white/55">{step.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FEATURED ===== -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl space-y-16 px-4">
      <div class="mx-auto max-w-2xl text-center reveal" x-intersect.once="$el.classList.add('shown')">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-600">Featured Treatments</p>
        <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Targeted solutions that work</h2>
      </div>
      {
        featured.map((feat, i) => (
          <div class="grid items-center gap-10 lg:grid-cols-2 reveal" x-intersect.once="$el.classList.add('shown')">
            <div class={i % 2 === 1 ? 'lg:order-2' : ''}>
              <img src={feat.img} alt={feat.name} loading="lazy" class="aspect-[16/11] w-full rounded-3xl border border-slate-100 object-cover shadow-soft" />
            </div>
            <div class={i % 2 === 1 ? 'lg:order-1' : ''}>
              <span class="inline-flex rounded-full bg-brand-50 px-3 py-1 text-xs font-bold text-brand-700">{feat.tag}</span>
              <h3 class="mt-4 font-display text-3xl font-extrabold tracking-tight">{feat.name}</h3>
              <p class="mt-3 text-slate-500">{feat.desc}</p>
              <ul class="mt-5 space-y-2.5">
                {feat.points.map((point) => (
                  <li class="flex items-center gap-2.5 text-sm font-semibold text-ink"><span class="grid h-5 w-5 place-items-center rounded-full bg-brand-100 text-brand-700"><svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg></span><span>{point}</span></li>
                ))}
              </ul>
              <a href="/services" class="mt-7 inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-brand-600 to-brand-700 px-6 py-3 font-bold text-white shadow-lift transition hover:brightness-110">Explore Services</a>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ===== BEFORE / AFTER ===== -->
  <section class="bg-mist py-20">
    <div class="mx-auto max-w-5xl px-4">
      <div class="mx-auto max-w-2xl text-center reveal" x-intersect.once="$el.classList.add('shown')">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-600">Real Results</p>
        <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">See the difference</h2>
        <p class="mt-4 text-lg text-slate-500">Drag the handle to reveal the transformation after treatment.</p>
      </div>
      <div x-data="{ pos:50 }" class="mt-12 reveal" x-intersect.once="$el.classList.add('shown')">
        <div class="relative aspect-[16/9] w-full select-none overflow-hidden rounded-3xl border border-slate-200 shadow-soft">
          <img src="/img/after.svg" alt="After treatment" class="absolute inset-0 h-full w-full object-cover" />
          <span class="absolute bottom-3 right-3 z-[5] rounded-full bg-brand-600 px-3 py-1 text-xs font-bold text-white">After</span>
          <div class="absolute inset-0 overflow-hidden" :style="`width:${pos}%`">
            <img src="/img/before.svg" alt="Before treatment" class="absolute inset-0 h-full w-full max-w-none object-cover" :style="`width:${10000/pos}%`" />
            <span class="absolute bottom-3 left-3 rounded-full bg-ink/70 px-3 py-1 text-xs font-bold text-white">Before</span>
          </div>
          <div class="pointer-events-none absolute inset-y-0 z-10 w-0.5 bg-white shadow-sm" :style="`left:${pos}%`">
            <span class="absolute top-1/2 -translate-x-1/2 -translate-y-1/2 grid h-10 w-10 place-items-center rounded-full bg-white text-brand-700 shadow-lift"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="m9 7-5 5 5 5M15 7l5 5-5 5"></path></svg></span>
          </div>
          <input type="range" min="2" max="98" x-model="pos" aria-label="Reveal before and after" class="absolute inset-0 z-20 h-full w-full cursor-ew-resize opacity-0" />
        </div>
      </div>
    </div>
  </section>

  <!-- ===== TESTIMONIALS ===== -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4">
      <div class="mx-auto max-w-2xl text-center reveal" x-intersect.once="$el.classList.add('shown')">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-600">Testimonials</p>
        <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Loved by 2,000+ neighbors</h2>
      </div>
      <div x-data={carouselData} x-init="start()" @mouseenter="stop()" @mouseleave="start()" class="mt-12 reveal" x-intersect.once="$el.classList.add('shown')">
        <div class="overflow-hidden rounded-3xl border border-slate-100 bg-mist shadow-soft">
          <div class="flex transition-transform duration-700 ease-out" :style="`transform: translateX(-${active*100}%)`">
            {
              reviews.map((r) => (
                <figure class="w-full shrink-0 p-8 sm:p-12">
                  <div class="flex text-accent-500" aria-hidden="true">{Array.from({ length: r.stars }).map(() => <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d={star}></path></svg>)}</div>
                  <blockquote class="mt-5 text-lg font-medium leading-relaxed text-ink sm:text-xl">“{r.text}”</blockquote>
                  <figcaption class="mt-6 flex items-center gap-3"><span class="grid h-12 w-12 place-items-center rounded-full bg-gradient-to-br from-brand-500 to-brand-700 font-display text-lg font-bold text-white">{r.name.charAt(0)}</span><span><span class="block font-bold">{r.name}</span><span class="block text-sm text-slate-500">{r.location}</span></span></figcaption>
                </figure>
              ))
            }
          </div>
        </div>
        <div class="mt-6 flex items-center justify-center gap-4">
          <button @click="prev()" class="grid h-11 w-11 place-items-center rounded-full border border-slate-200 transition hover:bg-brand-50 hover:text-brand-700" aria-label="Previous review"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="m15 18-6-6 6-6"></path></svg></button>
          <div class="flex gap-2">
            {reviews.map((_, i) => <button @click={`active=${i}`} :class={`active===${i} ? 'w-7 bg-brand-600' : 'w-2.5 bg-slate-300'`} class="h-2.5 rounded-full transition-all" aria-label={`Go to review ${i + 1}`}></button>)}
          </div>
          <button @click="next()" class="grid h-11 w-11 place-items-center rounded-full border border-slate-200 transition hover:bg-brand-50 hover:text-brand-700" aria-label="Next review"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="m9 18 6-6-6-6"></path></svg></button>
        </div>
        <div class="mt-6 text-center"><a href="/reviews" class="inline-flex items-center gap-1.5 text-sm font-bold text-brand-700">Read all reviews <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a></div>
      </div>
    </div>
  </section>

  <!-- ===== EMERGENCY CTA ===== -->
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-600 via-brand-700 to-brand-800 py-20 text-white">
    <div class="absolute inset-0 bg-dots opacity-20"></div>
    <div class="absolute -right-20 -top-20 h-72 w-72 rounded-full bg-accent-500/20 blur-3xl"></div>
    <div class="relative mx-auto max-w-4xl px-4 text-center reveal" x-intersect.once="$el.classList.add('shown')">
      <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-bold backdrop-blur-sm">🚨 Pest emergency?</span>
      <h2 class="mt-5 font-display text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">Need Immediate Pest Control Service?</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-white/80">Our technicians are on standby. Get a same-day visit and reclaim your home today.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={SITE.phoneHref} class="inline-flex items-center gap-2 rounded-full bg-white px-7 py-3.5 font-bold text-brand-700 shadow-lift transition hover:bg-brand-50"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"></path></svg>Call Now: {SITE.phone}</a>
        <a href="/contact" class="inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/10 px-7 py-3.5 font-bold backdrop-blur-sm transition hover:bg-white/20">Schedule Inspection</a>
      </div>
    </div>
  </section>
</BaseLayout>
